MONGODB_URI=mongodb://localhost:27017/finperk?replicaSet=rs0&directConnection=true
NATS_URL=nats://localhost:4222

# GoCardless (usa Secret ID + Secret Key; déjalos vacíos en local para usar Sandbox)
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_TOKEN_STORE=nats

# Jev en OpenRouter (solo requiere 1 API key de OpenRouter en OPENROUTER_API_KEY o JEV_API_KEY)
JEV_PROVIDER=openrouter
JEV_MODEL=typesafe/jev-1.14
JEV_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
JEV_API_KEY=

# Scheduler y Notificaciones (opcionales)
SCHEDULER_INTERVAL=12h
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FCM_CREDENTIALS_PATH=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
